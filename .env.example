# ===== Django =====
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=django-insecure-replace-me-with-a-long-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ===== Database =====
# Primary: PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=campus_platform
DB_USER=campus_user
DB_PASSWORD=campus_pass_2026
DB_HOST=localhost
DB_PORT=5432

# Fallback SQLite (only used when DB_ENGINE=django.db.backends.sqlite3)
DB_NAME_SQLITE=db.sqlite3

# Postgres (uncomment when ready)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=campus
# DB_USER=campus
# DB_PASSWORD=secret
# DB_HOST=localhost
# DB_PORT=5432

# ===== LLM / Ollama =====
# OLLAMA_URL=http://localhost:11434/api/generate
# OLLAMA_MODEL=llama3
# LLM_TIMEOUT=30
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2:3b
LLM_TIMEOUT=60

# ===== RAG =====
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_PATH=ai_engine/vector_store_data/

# ===== i18n =====
DEFAULT_LANGUAGE=en

# ===== Email (dev uses console) =====
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For real email later:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Campus Platform <noreply@campus.local>

# ===== SMS (pluggable) =====
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER_ID=CAMPUS

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Document Rendering =====
DOC_RENDERER=libreoffice     # options: libreoffice | reportlab
LIBREOFFICE_PATH=            # Windows only; leave blank if in PATH

# ===== Document Signing =====
# A random secret used to sign document hashes. Rotate in production.
DOC_SIGNING_SECRET=change-me-to-a-random-string