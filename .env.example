# ===== Django =====
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=django-insecure-replace-me-with-a-long-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ===== Database =====
# SQLite (default for dev)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Postgres (uncomment when ready)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=campus
# DB_USER=campus
# DB_PASSWORD=secret
# DB_HOST=localhost
# DB_PORT=5432

# ===== LLM / Ollama =====
# OLLAMA_URL=http://localhost:11434/api/generate
# OLLAMA_MODEL=llama3
# LLM_TIMEOUT=30
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2:3b
LLM_TIMEOUT=60

# ===== RAG =====
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_PATH=ai_engine/vector_store_data/

# ===== i18n =====
DEFAULT_LANGUAGE=en